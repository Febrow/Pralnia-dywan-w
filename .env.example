# --- Backend / API ---
# Port serwera API (jednocześnie serwuje zbudowany frontend)
PORT=3000

# Sekret do podpisywania JWT — podmień przed produkcją
JWT_SECRET=change-me-in-production

# Lokalizacja bazy SQLite (relatywnie do apps/api)
DATABASE_URL="file:./data/pralnia.db"

# Folder na uploady (zdjęcia dywanów)
UPLOAD_DIR=./data/uploads
