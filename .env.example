# --- Backend / API ---
# Port serwera API (jednocześnie serwuje zbudowany frontend)
PORT=3000

# Sekret do podpisywania JWT — podmień przed produkcją (min. 32 znaki)
JWT_SECRET=change-me-in-production

# Połączenie do MySQL.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Przykłady:
#   lokalnie:        mysql://root:root@localhost:3306/pralnia
#   shared hosting:  mysql://uzytkownik:haslo@mysql.twojhost.pl:3306/nazwa_bazy
DATABASE_URL="mysql://pralnia:pralnia@localhost:3306/pralnia"

# Folder na uploady (zdjęcia dywanów). Wewnątrz apps/api/ albo absolutna ścieżka.
UPLOAD_DIR=./data/uploads

# --- Tylko dla docker-compose ---
APP_PORT=3000
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=pralnia
MYSQL_USER=pralnia
MYSQL_PASSWORD=pralnia
